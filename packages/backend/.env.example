NODE_ENV=development
PORT=3847
HOST=0.0.0.0
TRUST_PROXY=false

# JSON file storage directory (relative to packages/backend or absolute).
# Used for uploads, agent workspaces, skills on disk, etc. — not for relational collection data.
DATA_DIR=./data

# PostgreSQL is required for all collection data (users, boards, messages, …).
DATABASE_URL=postgres://openwork:openwork@localhost:5432/openwork
# DB_MIGRATIONS_DIR=./drizzle
# DB_MIGRATIONS_TABLE=__drizzle_migrations
# DB_MIGRATIONS_SCHEMA=drizzle

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# Public backend origin for runner-spawned CLIs. Required for hosted deployments.
# Local single-machine development can leave this unset and use HOST/PORT.
# OPENWORK_PUBLIC_API_URL=https://openwork.example.com

# JWT — change the secret in production!
# JWT_SECRET=change-me-to-a-real-secret-in-production!!
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# SECRET_ENCRYPTION_KEY=use-a-separate-32-character-secret-for-agent-env-secrets

# HTTPS — generate certs with: pnpm certs:generate
# Leave empty to run plain HTTP (recommended for prototyping)
# TLS_CERT_PATH=../../certs/localhost.pem
# TLS_KEY_PATH=../../certs/localhost-key.pem

# WhatsApp Business API
# WHATSAPP_WEBHOOK_BASE_URL=https://yourdomain.com

# Instagram / Facebook Messenger
# INSTAGRAM_WEBHOOK_BASE_URL=https://yourdomain.com
# INSTAGRAM_APP_SECRET=

# Novofon VoIP
# NOVOFON_WEBHOOK_BASE_URL=https://yourdomain.com

# Voximplant VoIP
# VOXIMPLANT_WEBHOOK_BASE_URL=https://yourdomain.com

# Media / file uploads
UPLOAD_DIR=./uploads
# Max non-multipart request body size in bytes (Fastify bodyLimit)
BODY_LIMIT_BYTES=1048576

# Backups
BACKUP_DIR=./backups
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENABLED=true

# Rate limiting (defaults are relaxed for prototyping)
# RATE_LIMIT_GLOBAL_MAX=10000
# RATE_LIMIT_AUTH_MAX=1000
# RATE_LIMIT_API_MAX=10000

# Agent execution requires a connected `openwork-runner`.
# Create pairing codes in Settings -> Runners.
# AGENT_RUNNER_ID=
# REMOTE_AGENT_RUN_TIMEOUT_MS=0
# Explicit same-host development compatibility for legacy backend-local filesystem
# browse/pick/reveal/reference routes. Keep false in hosted deployments.
# Same-machine dev: auto-reconcile legacy repository roots that already exist on disk.
# OPENWORK_LOCAL_DEV_SAME_HOST_FILESYSTEM=false

# Notifications
# NOTIFICATION_CRON=*/15 * * * *
# NOTIFICATION_CRON_ENABLED=true


# Web Push — VAPID keys (stubbed out — deps removed for prototyping)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@workspace.local
